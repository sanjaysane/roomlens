# ── RoomLens environment ──────────────────────────────────────────────
# Copy to .env for local development. Never commit real credentials.

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WEBHOOK_VERIFY_TOKEN=roomlens-dev-verify

# Database: leave empty to use the in-memory fake (dev/tests).
# Example: postgresql://roomlens:secret@localhost:5432/roomlens
DATABASE_URL=

# Media storage: "local" (./media/) or "supabase"
MEDIA_BACKEND=local
MEDIA_DIR=./media
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=roomlens

# App
DEFAULT_LANGUAGE=en
